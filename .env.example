# Modelo genérico — preencha com os dados das suas bases locais.
# Este arquivo NÃO deve conter dados reais; copie para .env (que é ignorado pelo git).

# === Ambiente SQL Server (Docker) ===
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=TroqueEstaSenha@123
MSSQL_PORT=1433
CONTAINER_NAME=mssql-recovery

# === Diretórios locais ===
# Caminho onde os arquivos originais (.mdf/.ldf) estão montados (somente leitura)
SRC_DATA_DIR=/var/tmp
# Volume de trabalho do contêiner (cópias editáveis)
WORK_DATA_DIR=/var/sqlserver/data

# === Base em recuperação ===
# Preencha por base (adicione _2, _3... para múltiplas)
DB_NAME=MinhaBase
DB_MDF=MinhaBase.mdf
DB_LDF=MinhaBase_log.ldf

# === Certificado TDE (se o banco estiver criptografado com TDE) ===
# Preencha com o certificado + chave privada obtidos do servidor de origem.
# Os arquivos .cer/.pvk devem estar em $SRC_DATA_DIR.
TDE_CERT_NAME=MinhaTdeCert
TDE_CERT_FILE=MinhaTdeCert.cer
TDE_CERT_KEY=MinhaTdeCert.pvk
TDE_CERT_PASSWORD=SenhaDaChavePrivada123

